# ============================================================
# Prediction-market trading bot configuration
# Copy this file to .env and fill in values. NEVER commit .env.
# ============================================================

# =========================== KALSHI ==========================
# The bot trades on Kalshi (CFTC-regulated, legal for US users).
# Create API keys at: kalshi.com -> profile -> Settings -> API keys
# (use demo.kalshi.co for the fake-money demo environment first).

# The Key ID shown when you create the API key (a UUID).
KALSHI_API_KEY_ID=

# Path to the RSA private key file (.pem) Kalshi gives you exactly once
# when creating the key. Keep it next to .env, e.g. kalshi_demo.pem
# (*.pem is gitignored). Example: kalshi_demo.pem
KALSHI_PRIVATE_KEY_PATH=

# demo = fake-money sandbox (demo.kalshi.co account)  <- START HERE
# prod = real money (kalshi.com account)
KALSHI_ENV=demo

# The market to trade: its ticker, shown on every Kalshi market page,
# e.g. KXHIGHNY-26JUL03-B87.5
MARKET_TICKER=

# --- Sports model (optional) ---
# Free API key from https://the-odds-api.com (500 requests/month tier).
# Leave empty to disable the sports model; the others run regardless.
ODDS_API_KEY=

# --- Safety rails (HARD RULES, enforced on every order path) ---
# true  = log what would happen, place ZERO real orders (default, keep it on)
# false = live trading enabled
DRY_RUN=true

# true = bot refuses to place ANY order, even in dry-run
KILL_SWITCH=false

# Max USD allowed in a single order. Orders above this are rejected.
MAX_ORDER_SIZE=5

# Max total USD across all open positions/orders. Orders that would push
# exposure past this are rejected.
MAX_TOTAL_EXPOSURE=20

# ================= LEADERBOARD COPY-TRADING (follow) =================
# Mirrors a Kalshi leaderboard trader you follow, sized by OUR Kelly on
# OUR bankroll. Kalshi exposes NO API that attributes a trade to an
# account (the public tape has no user field; /users and /leaderboard are
# 404), so the trigger is a push notification forwarded from your phone by
# an iOS Shortcut. See README "Copy-trading a leaderboard trader".

# Master switch. False = the copier does nothing at all.
FOLLOW_ENABLED=false

# Paper mode, INDEPENDENT of the global DRY_RUN so this copier can be armed
# or disarmed on its own. Leave true until FOLLOW_SCOREBOARD.md shows a
# positive settled net — his public record is not evidence that WE profit.
FOLLOW_DRY_RUN=true

# The account to mirror. A notification about anyone else is discarded.
FOLLOW_USERNAME=blushing.wildebeest7119

# Where follow_webhook is reachable, and the shared secret the iOS Shortcut
# sends as the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The webhook REFUSES to accept triggers when the key is unset.
FOLLOW_WEBHOOK_URL=
FOLLOW_WEBHOOK_KEY=

# How often the runner drains the webhook. 10s keeps end-to-end latency well
# inside the 2-minute target.
FOLLOW_POLL_SECONDS=10
FOLLOW_RUN_MINUTES=110

# SLIPPAGE GUARD — the most important setting here. He moves 100k-390k
# contracts per position, so his own order is what moved the book. If the
# ask has already run this many cents past his entry, skip: we would be
# buying his price impact, not his edge.
FOLLOW_MAX_SLIP_CENTS=3

# The copier's own price band. The global 60-90c band is wrong for this
# model — his entries cluster at 42-63c.
FOLLOW_MIN_PRICE_CENTS=10
FOLLOW_MAX_PRICE_CENTS=95

# Fraction of full Kelly for copies. Defaults to KELLY_FRACTION (0.25).
# An unproven edge does not earn a bigger multiplier than our own models.
FOLLOW_KELLY_FRACTION=0.25
