{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "sh",
      "args": [".claude/mcp/playwright-mcp.sh"],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {}
    },
    "memory": {
      "type": "stdio",
      "command": "sh",
      "args": [".claude/mcp/memory-mcp.sh"],
      "env": {}
    }
  }
}
